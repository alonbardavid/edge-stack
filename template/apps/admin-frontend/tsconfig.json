{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true
  },
  "references": [
    {
      "path": "../../libs/admin-contract"
    },
    {
      "path": "../../libs/contract"
    },
    {
      "path": "../../libs/ds"
    }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
