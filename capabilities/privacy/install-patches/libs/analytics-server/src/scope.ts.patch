+async function allowedEmissions(queued: Emission[]): Promise<Emission[]> {
+  const distinctIds = [...new Set(queued.map((e) => e.distinctId))];
+  const suppressed = await loadSuppressedUserIds(distinctIds).catch(
+    (err: unknown) => {
+      log.error("could not read tracking settings, dropping the batch", {
+        err,
+      });
+      return new Set(distinctIds);
+    },
   );
+  const allowed = queued.filter((e) => !suppressed.has(e.distinctId));
