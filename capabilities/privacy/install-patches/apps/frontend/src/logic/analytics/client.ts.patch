 export { posthog as analytics };
 
+/** Opting in is what lets the SDK store anything on the device, or send it. */
+export function applyTrackingSetting(tracking: TrackingSetting): void {
+  if (tracking !== "enabled") {
+    posthog.opt_out_capturing();
+    return;
+  }
+  if (posthog.has_opted_in_capturing()) {
+    return;
+  }
+  // The pageview fired at init was dropped while opted out, and opting in
+  // captures $opt_in rather than a pageview; later ones come from
+  // capture_pageview: "history_change".
+  posthog.opt_in_capturing({ captureEventName: false });
+  posthog.capture("$pageview");
+}
