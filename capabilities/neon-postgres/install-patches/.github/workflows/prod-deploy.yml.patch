+      # Production is the Neon project's default branch. Unlike staging and
+      # previews it is never created here: a missing project is a hard failure,
+      # so a deploy can never land on a brand new empty database.
+      - name: Resolve production database
+        id: neon
+        uses: ./.github/actions/neon-env
+        with:
+          api-key: ${{ secrets.NEON_API_KEY }}
+          project-id: ${{ secrets.NEON_PROJECT_ID }}
+          default-branch: "true"
+
+      # Migrations run BEFORE the deploy, so new code never sees an older schema.
+      - name: Apply production migrations
+        env:
+          DATABASE_URL: ${{ steps.neon.outputs.db_url }}
+        run: pnpm db:migrate
 
