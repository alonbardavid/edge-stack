+// Every non-production target tags the sender's local part with the environment
+// it belongs to (EMAIL_TAG), so mail that escaped a test environment is obvious
+// in the inbox (and filterable) instead of being indistinguishable from the real
+// product's mail. The tag rides along in replies and bounces because it is part
+// of the address, not a header. Production passes no EMAIL_TAG and sends as the
+// bare address. Applied here, at config-generation time, so EMAIL_FROM in the
+// generated config is already final and @lib/email-service stays untouched.
+function taggedSender(address, tag) {
+  if (!tag) {
+    return address;
+  }
+  const [local, domain] = address.split("@");
+  if (!local || !domain) {
+    console.error(`Cannot tag "${address}": expected a local@domain address`);
+    process.exit(1);
+  }
+  return `${local}+${tag}@${domain}`;
+}
