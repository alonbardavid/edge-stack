{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "project-name-admin-local",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// No "directory": vite build sets it to its client output (dist/client).
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	// The backend's database: the same name, so local dev shares its state
	// (vite.config.ts persists there). Never add a database_id:
	// scripts/gen-wrangler-config.mjs injects one per deploy target.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "project-name-local"
		}
	]
}
