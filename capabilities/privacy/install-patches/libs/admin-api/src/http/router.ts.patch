+// A lifecycle action either happens or says why not, as the error its
+// procedure declares; anything else is a bug for the error interceptor.
+async function lifecycle(action: () => Promise<void>) {
+  try {
+    await action();
+    return { ok: true as const };
+  } catch (error) {
+    if (error instanceof UserLifecycleError) {
+      log.warning("lifecycle action refused", {
+        code: error.code,
+        reason: error.message,
+      });
+      throw new ORPCError(error.code, { message: error.message });
+    }
+    throw error;
+  }
+}
